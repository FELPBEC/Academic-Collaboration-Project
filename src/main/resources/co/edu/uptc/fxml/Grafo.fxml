<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="650.0" prefWidth="1050.0" styleClass="fondo-general"
           stylesheets="@../styles/styles.css"
           xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uptc.ViewController.GrafoController">

    <children>
        <BorderPane>
            <padding>
                <Insets bottom="16.0" left="85.0" right="28.0" top="14.0" />
            </padding>

            <!-- ENCABEZADO -->
            <top>
                <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets bottom="10.0" />
                    </BorderPane.margin>
                    <children>
                        <Label styleClass="title" text="%graph.title" />
                        <Label styleClass="general-text" text="%graph.subtitle" />
                    </children>
                </VBox>
            </top>

            <!-- LIENZO DEL GRAFO CON SCROLL -->
            <center>
                <ScrollPane fx:id="scrollGrafo" fitToHeight="true" fitToWidth="true"
                            pannable="true" styleClass="panel-filtros" BorderPane.alignment="CENTER">
                    <content>
                        <StackPane fx:id="contenedorLienzo" style="-fx-background-color: #fafafa;" />
                    </content>
                </ScrollPane>
            </center>

            <!-- LEYENDA Y CONTROLES DE ZOOM -->
            <bottom>
                <HBox alignment="CENTER" spacing="18.0" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets top="10.0" />
                    </BorderPane.margin>
                    <children>
                        <HBox fx:id="boxLeyendaNodos" alignment="CENTER" spacing="14.0"
                              styleClass="panel-filtros">
                            <padding>
                                <Insets bottom="6.0" left="14.0" right="14.0" top="6.0" />
                            </padding>
                        </HBox>

                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#onZoomOut"
                                        styleClass="boton-estrella" text="-" />
                                <Button mnemonicParsing="false" onAction="#onResetZoom"
                                        styleClass="boton-estrella" text="%graph.button.reset" />
                                <Button mnemonicParsing="false" onAction="#onZoomIn"
                                        styleClass="boton-estrella" text="+" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </bottom>
        </BorderPane>

        <!-- SELECTOR DE IDIOMA Y MENÚ LATERAL -->
        <fx:include source="SelectorIdioma.fxml" />
        <fx:include source="MenuLateral.fxml" />
    </children>
</StackPane>